{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build all packages",
            "type": "shell",
            "command": "source /opt/ros/humble/setup.bash &&  colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Debug && source install/setup.bash",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}